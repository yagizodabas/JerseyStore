@{
    ViewData["Title"] = "Forma koleksiyonu";
}
<section class="store-hero">
    <p class="eyebrow">JERSEYSTORE / FORMA KOLEKSİYONU</p>
    <h1>Renklerini<br /><span>gururla taşı.</span></h1>
    <p>Takımını bul, stoktaki formaları keşfet.</p>
    <a class="store-button" href="#collection">Koleksiyonu keşfet <span aria-hidden="true">↗</span></a>
</section>
<section id="collection" class="collection" aria-labelledby="collection-title">
    <div class="collection-heading">
        <div><p class="eyebrow">KOLEKSİYON</p><h2 id="collection-title">Takımının renkleri.</h2></div>
        <button id="reload-products" class="btn btn-outline-dark" type="button">Yenile</button>
    </div>
    <p id="catalog-status" role="status" aria-live="polite">Ürünler yükleniyor…</p>
    <div id="products" class="product-grid" aria-busy="true"></div>
</section>
@section Scripts {
    <script src="~/js/cart-store.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
}
