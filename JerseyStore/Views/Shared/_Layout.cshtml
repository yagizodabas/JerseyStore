<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="JerseyStore forma koleksiyonu ve güncel stok bilgileri." />
    <title>@ViewData["Title"] - JerseyStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <header class="store-header">
        <a class="store-brand" asp-controller="Products" asp-action="Index">JERSEY<span>STORE.</span></a>
        <nav aria-label="Ana menü">
            <a href="/#collection">Koleksiyon</a>
            <a asp-controller="Orders" asp-action="Cart">Sepet</a>
        </nav>
    </header>
    <main id="main">@RenderBody()</main>
    <footer class="store-footer"><span>JERSEYSTORE</span><a asp-controller="Home" asp-action="Privacy">Veri kullanımı</a><span>Forma koleksiyonu · @DateTime.UtcNow.Year</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
