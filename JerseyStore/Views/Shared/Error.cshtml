@model ErrorViewModel
@{
    ViewData["Title"] = "İşlem tamamlanamadı";
}
<section class="collection">
    <h1 class="page-title">İşlem tamamlanamadı.</h1>
    <p>Beklenmeyen bir sorun oluştu. Sipariş gönderirken bu sayfaya ulaştıysanız yeniden göndermeden önce sipariş durumunu kontrol edin.</p>
    @if (Model.ShowRequestId)
    {
        <p>Destek için işlem kimliği: <code>@Model.RequestId</code></p>
    }
    <a class="store-button" asp-controller="Products" asp-action="Index">Koleksiyona dön</a>
</section>
